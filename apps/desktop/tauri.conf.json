{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Instructor Essentials",
  "version": "0.1.0",
  "identifier": "com.instructoressentials.app",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "ui"
  },
  "app": {
    "windows": [
      {
        "title": "Instructor Essentials",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 650,
        "center": true,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
