name: Deploy Instructors' Toolkit to GitHub Pages

on:
  push:
    branches:
      - main
  workflow_dispatch:

permissions:
  contents: read
  pages: write
  id-token: write

concurrency:
  group: pages
  cancel-in-progress: false

jobs:
  deploy:
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 20

      - name: Build Standalone Web Apps
        run: |
          npm run build:studio

      - name: Stage GitHub Pages site
        run: |
          mkdir -p _site
          # Sheet Builder (primary entrypoint & alias)
          cp builder/studio.html _site/index.html
          cp builder/studio.html _site/studio.html
          # Checker Studio (OMR & grading dashboard)
          cp builder/checker.html _site/checker.html
          # Disable Jekyll processing on GitHub Pages
          touch _site/.nojekyll

      - name: Upload Pages artifact
        uses: actions/upload-pages-artifact@v3
        with:
          path: _site

      - name: Deploy to GitHub Pages
        id: deployment
        uses: actions/deploy-pages@v4
